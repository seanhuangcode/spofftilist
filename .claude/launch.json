{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spofftilist-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "spofftilist-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-web.mjs"
      ],
      "port": 8888,
      "url": "http://127.0.0.1:8888"
    }
  ]
}